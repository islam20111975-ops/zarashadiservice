rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "ngogrant454@gmail.com";
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if owner(userId) || isAdmin();
      allow create: if owner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.age is number
        && request.resource.data.age >= 18
        && request.resource.data.age <= 100
        && request.resource.data.income is string
        && request.resource.data.photoURL is string;
      allow update: if isAdmin()
        || (owner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name","address","phone","age","income","photoURL","updatedAt"
          ]));
      allow delete: if isAdmin();
    }

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /profileBiodataPrivate/{profileId} {
      allow read: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/biodataUnlocks/$(request.auth.uid + "_" + profileId))
          && get(/databases/$(database)/documents/biodataUnlocks/$(request.auth.uid + "_" + profileId)).data.status == "approved");
      allow write: if isAdmin();
    }

    match /profileContact/{profileId} {
      allow read: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/mobileAccess/$(request.auth.uid + "_" + profileId))
          && get(/databases/$(database)/documents/mobileAccess/$(request.auth.uid + "_" + profileId)).data.status == "approved");
      allow write: if isAdmin();
    }

    match /profilePrivate/{profileId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if request.resource.data.profileId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.fee == 100
        && request.resource.data.status == "payment_pending"
        && request.resource.data.utr == "";
      allow read, update, delete: if isAdmin();
      allow update: if !signedIn()
        && resource.data.utr == ""
        && request.resource.data.utr is string
        && request.resource.data.utr != ""
        && request.resource.data.status == "utr_submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "utr","status","utrSubmittedAt"
        ])
        && exists(/databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower()))
        && get(/databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower())).data.registrationId == registrationId;
    }

    match /utrClaims/{utrId} {
      allow create: if !signedIn()
        && !exists(/databases/$(database)/documents/utrClaims/$(utrId))
        && request.resource.data.registrationId is string
        && request.resource.data.utr is string;
      allow read, update, delete: if isAdmin();
    }

    match /walletRechargeRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "pending"
        && request.resource.data.utr is string
        && request.resource.data.utr != "";
      allow update, delete: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /biodataUnlocks/{unlockId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /mobileAccess/{accessId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /paidAccessRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.profileId is string
        && request.resource.data.amount is number
        && ((request.resource.data.type == "biodata" && request.resource.data.amount == 100)
          || (request.resource.data.type == "mobile" && request.resource.data.amount == 500))
        && request.resource.data.type is string
        && request.resource.data.status == "pending"
        && request.resource.data.utr is string
        && request.resource.data.utr != "";
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
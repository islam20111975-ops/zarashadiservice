rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public profile data can be read by the website.
    match /profiles/{profileId} {
      allow read: if true;

      // Profile creation/edit/delete must be done through the
      // authenticated admin account.
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    // Registration/payment records are private.
    match /registrations/{registrationId} {
      allow read, create, update: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
      allow delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
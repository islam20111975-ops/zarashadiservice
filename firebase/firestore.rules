rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /users/{userId} {\n      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "ngogrant454@gmail.com");\n      allow create, update: if request.auth != null && request.auth.uid == userId;\n      allow delete: if request.auth != null && request.auth.token.email == "ngogrant454@gmail.com";\n    }\n\n    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /registrations/{registrationId} {
      allow create: if true
        && request.resource.data.profileId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.fee == 100
        && request.resource.data.status == "payment_pending"
        && request.resource.data.utr == "";
      allow read, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
      allow update: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
      allow update: if request.auth == null
        && resource.data.utr == ""
        && request.resource.data.utr is string
        && request.resource.data.utr != ""
        && request.resource.data.status == "utr_submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["utr","status","utrSubmittedAt"])
        && exists(/databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower()))
        && get(/databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower())).data.registrationId == registrationId;
    }

    match /utrClaims/{utrId} {
      allow create: if request.auth == null
        && !exists(/databases/$(database)/documents/utrClaims/$(utrId))
        && request.resource.data.registrationId is string
        && request.resource.data.utr is string;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
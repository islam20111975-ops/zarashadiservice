rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /settings/{settingId} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.token.email == "ngogrant454@gmail.com";\n    }\n\n    match /registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
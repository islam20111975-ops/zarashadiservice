rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    // USER PROFILE
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if isAdmin();
    }

    // BIODATA
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // PUBLIC / ADMIN SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // OLD ₹100 REGISTRATION SYSTEM
    match /registrations/{registrationId} {
      allow create: if
        request.resource.data.profileId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.fee == 100
        && request.resource.data.status == "payment_pending"
        && request.resource.data.utr == "";

      allow read, delete: if isAdmin();

      allow update: if isAdmin();

      // Anonymous UTR submission for the existing payment page.
      allow update: if request.auth == null
        && resource.data.utr == ""
        && request.resource.data.utr is string
        && request.resource.data.utr != ""
        && request.resource.data.status == "utr_submitted"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["utr","status","utrSubmittedAt"])
        && exists(
          /databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower())
        )
        && get(
          /databases/$(database)/documents/utrClaims/$(request.resource.data.utr.lower())
        ).data.registrationId == registrationId;
    }

    // UTR DUPLICATE PROTECTION
    match /utrClaims/{utrId} {
      allow create: if request.auth == null
        && !exists(/databases/$(database)/documents/utrClaims/$(utrId))
        && request.resource.data.registrationId is string
        && request.resource.data.utr is string;

      allow read, update, delete: if isAdmin();
    }

    // WALLET RECHARGE REQUESTS
    // User can submit only their own recharge request.
    // Only Admin can approve/reject/edit/delete it.
    match /walletRechargeRequests/{requestId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "pending";

      allow update, delete: if isAdmin();
    }

    // WALLET TRANSACTIONS
    // Financial ledger is Admin-controlled. Users can only read their own records.
    match /walletTransactions/{transactionId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // ₹100 BIODATA UNLOCKS
    // Actual unlock is Admin-controlled after payment verification.
    match /biodataUnlocks/{unlockId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // ₹500 MOBILE / CONTACT ACCESS
    // Actual access is Admin-controlled after payment verification.
    match /mobileAccess/{accessId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.uid == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // Everything else closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
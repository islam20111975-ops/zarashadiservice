rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /registrations/{registrationId} {
      allow create: if true;
      allow read, delete: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
      allow update: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
      allow update: if request.auth == null
        && resource.data.utr == ""
        && request.resource.data.utr is string
        && request.resource.data.utr != ""
        && request.resource.data.status == "utr_submitted"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["utr","status","utrSubmittedAt"]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
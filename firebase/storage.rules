rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile.jpg {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "ngogrant454@gmail.com");\n    }\n\n    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /payment/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ngogrant454@gmail.com";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}